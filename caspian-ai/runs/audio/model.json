{
  "sample_rate": 16000,
  "clip_seconds": 2.0,
  "classes": [
    "background",
    "boat_motor",
    "gunshot",
    "aircraft",
    "chainsaw"
  ],
  "background_class": "background",
  "features": {
    "n_fft": 1024,
    "hop_length": 160,
    "n_mels": 64,
    "fmin": 20,
    "fmax": 8000
  },
  "model": {
    "channels": [
      32,
      64,
      128,
      256
    ],
    "dropout": 0.3,
    "specaugment": true
  },
  "data": {
    "raw_dir": "data/raw",
    "processed_dir": "data/processed",
    "manifest": "data/manifest.csv",
    "val_fraction": 0.15,
    "test_fraction": 0.15,
    "mix_prob": 0.7,
    "snr_db": [
      -10,
      20
    ],
    "gain_db": [
      -6,
      6
    ]
  },
  "train": {
    "epochs": 40,
    "batch_size": 32,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "patience": 20,
    "seed": 42,
    "num_workers": 0,
    "out_dir": "runs/audio"
  },
  "inference": {
    "window_seconds": 2.0,
    "hop_seconds": 0.5,
    "thresholds": {
      "boat_motor": 0.6,
      "gunshot": 0.5,
      "chainsaw": 0.9,
      "aircraft": 0.9
    },
    "min_consecutive": {
      "boat_motor": 3,
      "gunshot": 1,
      "chainsaw": 3,
      "aircraft": 4
    },
    "severity": {
      "boat_motor": "medium",
      "gunshot": "high",
      "chainsaw": "high",
      "aircraft": "info",
      "unknown_sound": "low"
    },
    "labels_ru": {
      "boat_motor": "Шум лодочного мотора",
      "gunshot": "Выстрел",
      "chainsaw": "Бензопила (возможная рубка)",
      "aircraft": "Авиация (вертолёт/самолёт)",
      "unknown_sound": "Неизвестный звук — требуется проверка"
    },
    "ood": {
      "enabled": true,
      "min_consecutive": 2
    },
    "edge_thresholds": {
      "boat_motor": 0.4,
      "gunshot": 0.35,
      "chainsaw": 0.5,
      "aircraft": 0.8
    }
  }
}